# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
PORTAL_SECRET=replace-with-a-different-random-32-byte-secret

# Supabase Postgres: use the direct database URL for migrations; use a pooler URL for runtime if required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public

# Resend: sender domain must be verified.
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=ClientFlow <notifications@your-verified-domain.example>

# S3-compatible storage (Cloudflare R2)
AWS_ACCESS_KEY_ID=your_r2_access_key
AWS_SECRET_ACCESS_KEY=your_r2_secret_key
AWS_REGION=auto
AWS_S3_BUCKET=your_bucket_name
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Pilot seed: creates the initial owner and organization. No password is stored.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_NAME=Agency Owner
SEED_ORGANIZATION_NAME=Pilot Agency

# Stripe test mode; required only when enabling the billing webhook.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
